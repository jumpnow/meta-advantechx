# Local configuration for meta-advantech-imx8 images
# Only tested with the Advantech imx8ulp ROM2620 eval board
# Yocto Project 5.0 Poky distribution [scarthgap] branch

ACCEPT_FSL_EULA = "1"

DISTRO = "poky"

DISTRO_FEATURES = "ext2 opengl optee security systemd usbhost ${DISTRO_FEATURES_LIBC}"

DISTRO_FEATURES_BACKFILL_CONSIDERED += "pulseaudio sysvinit"

DISTRO_FEATURES:remove = "ptest"

INIT_MANAGER = "systemd"

EXTRA_IMAGEDEPENDS += "\
    virtual/bootloader \
    u-boot-scr \
"

MACHINE = "imx8ulprom2620a1"

DL_DIR = "/src/mickledore"
SSTATE_DIR = "/oe9/amx8/sstate-cache"
TMPDIR = "/oe9/amx8/tmp"

PACKAGE_CLASSES = "package_ipk"

SDKMACHINE = "x86_64"

EXTRA_IMAGE_FEATURES = "debug-tweaks"

PATCHRESOLVE = "noop"
RM_OLD_IMAGE = "1"
INHERIT += "rm_work"
CONF_VERSION = "2"
