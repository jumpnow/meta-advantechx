# Local configuration for meta-advantechx images
# Only tested with the Advantech imx8ulp ROM2620 eval board

ACCEPT_FSL_EULA = "1"

DISTRO = "poky"

DISTRO_FEATURES = "ext2 opengl systemd usbhost ${DISTRO_FEATURES_LIBC}"

DISTRO_FEATURES_BACKFILL_CONSIDERED += "pulseaudio sysvinit"

DISTRO_FEATURES:remove = "ptest"

INIT_MANAGER = "systemd"

EXTRA_IMAGEDEPENDS += "\
    virtual/bootloader \
    u-boot-scr \
"

PACKAGE_CLASSES = "package_ipk"

SDKMACHINE = "x86_64"

PREFERRED_VERSION_opencv:mx8-nxp-bsp = "4.9.%"

MACHINE = "imx8ulprom2620a1"

KERNEL_DEVICETREE_BASENAME = "imx8ulp-rom2620-a1-lt9211"
#KERNEL_DEVICETREE_BASENAME = "imx8ulp-rom2620-a1-lt9211-800x480"

IMAGE_FSTYPES = "tar.gz wic.zst"
#IMAGE_FSTYPES = "tar.gz"

WKS_FILE = "adv-imx-uboot-bootpart.wks.in"

#DL_DIR = "/src/scarthgap"
#SSTATE_DIR = "/oe2/advantechx/sstate-cache"
#TMPDIR = "/oe2/advantechx/tmp"

EXTRA_IMAGE_FEATURES = "debug-tweaks"

PATCHRESOLVE = "noop"
RM_OLD_IMAGE = "1"
INHERIT += "rm_work create-spdx"
CONF_VERSION = "2"
